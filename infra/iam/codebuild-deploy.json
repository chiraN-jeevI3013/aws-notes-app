{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployLambdaCode",
      "Effect": "Allow",
      "Action": ["lambda:UpdateFunctionCode", "lambda:GetFunction", "lambda:GetFunctionConfiguration"],
      "Resource": "arn:aws:lambda:us-east-2:ACCOUNT_ID:function:notes-app-api"
    },
    {
      "Sid": "DeployWebsite",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::WEB_BUCKET/index.html"
    }
  ]
}
